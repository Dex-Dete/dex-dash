; Engine configuration file.
; DEX DASH - original rhythm platformer
config_version=5

[application]

config/name="DEX DASH"
config/description="A fast-paced original rhythm platformer. Jump, dash and spin through neon worlds."
config/version="0.1.0"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Assets="*res://scripts/autoload/Assets.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
StatsManager="*res://scripts/autoload/StatsManager.gd"
AchievementManager="*res://scripts/autoload/AchievementManager.gd"
UnlockManager="*res://scripts/autoload/UnlockManager.gd"
DailyManager="*res://scripts/autoload/DailyManager.gd"
Localization="*res://scripts/autoload/Localization.gd"
GameFlow="*res://scripts/autoload/GameFlow.gd"
InputActions="*res://scripts/autoload/InputActions.gd"
ThemeManager="*res://scripts/autoload/ThemeManager.gd"
BeatManager="*res://scripts/autoload/BeatManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/energy_saving/keep_screen_on=true

