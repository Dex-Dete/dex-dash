static func get_level(id: String) -> Dictionary:
	for lv in catalog():
		if lv["id"] == id:
			return lv
	return {}


static func unlock_next(id: String) -> String:
	var ids := []
	for lv in catalog():
		ids.append(lv["id"])
	var i := ids.find(id)
	if i >= 0 and i < ids.size() - 1:
		return ids[i + 1]
	return ""


static func previous_level(id: String) -> String:
	var ids := []
	for lv in catalog():
		ids.append(lv["id"])
	var i := ids.find(id)
	if i > 0:
		return ids[i - 1]
	return ""


static func difficulty_of(id: String) -> String:
	var lv := get_level(id)
	return str(lv.get("difficulty", "easy"))


# ---- design helpers ----

static func _make(id: String, name: String, difficulty: String, music: String,
		theme: String, bpm: int, length: int, extra: Array, builder: Callable) -> Dictionary:
	var ob: Array = []
	builder.call(ob)
	var d := {
		"id": id, "name": name, "difficulty": difficulty, "music": music,
		"theme": theme, "bpm": bpm, "length": length,
		"start": {"x": -3, "y": -1}, "objects": ob,
	}
	if not extra.is_empty():
		for e in extra:
			for k in e.keys():
				if k == "start" and e[k] is Array:
					d[k] = {"x": int(e[k][0]), "y": int(e[k][1])}
				else:
					d[k] = e[k]
	return d


static func _g(ob: Array, x0: int, x1: int, y: int) -> void:
	for x in range(x0, x1):
		ob.append({"t": "ground", "x": x, "y": y})


